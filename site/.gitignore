# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — but keep the .example template, it's setup docs, not a secret
.env*
!.env*.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# media — videos only, and only under public/content/
# These are ~186 MB of the repo's ~188 MB of content and are served from
# Supabase Storage (MEDIA_BASE_URL); committing them re-bundled every byte
# into every Vercel deployment's static output. Keep them out of git; the
# build discovers them by name via lib/content-manifest.json.
# Poster/cover images stay TRACKED on purpose — all 13 of them total 1.6 MB,
# and keeping them on disk is what lets findPosterFor() keep pairing posters
# to videos off the real filesystem.
/public/content/**/*.mp4
/public/content/**/*.webm
/public/content/**/*.mov
