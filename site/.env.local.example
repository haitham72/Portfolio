# Copy to .env.local (gitignored) and fill in from your Supabase project's
# Settings -> API page. See README.md's "Private preview / Google sign-in
# gate" section for the full setup walkthrough.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. NEVER prefix this with NEXT_PUBLIC_, never import it from a
# "use client" file — it bypasses Row Level Security entirely.
SUPABASE_SERVICE_ROLE_KEY=

# REQUIRED. Videos under public/content/ are gitignored (~186 MB) and live in
# a public Vercel Blob store instead of being bundled into every deployment
# (Blob is billed separately from deployment storage, so one copy stays one
# copy). This is what points every media URL at that store; without it
# lib/content.ts emits local /content/... paths for files that are not
# deployed, and every video 404s. Set it here AND on Vercel for both
# Production and Preview -- it's read at build time.
# Format: the store's origin, no trailing slash, no path.
#   https://<store-id>.public.blob.vercel-storage.com
# Populate the store with:
#   node --env-file=.env.local scripts/sync-content-to-blob.mjs
MEDIA_BASE_URL=

# Credentials for that sync script. `vercel env pull` writes BLOB_STORE_ID and
# VERCEL_OIDC_TOKEN here and the Blob SDK picks them up automatically -- but
# only if the store's project connection includes the Development environment
# (store -> Projects tab -> ... -> Update Project Connection). The OIDC token
# is short-lived; rerun `vercel env pull` if a later sync fails to
# authenticate. A long-lived BLOB_READ_WRITE_TOKEN works instead, if you have
# one. None of these are needed to run the site, only to upload media.
#
# NOTE: `vercel env pull` OVERWRITES this file's real counterpart
# (.env.local). Anything you set only locally -- MEDIA_BASE_URL included, if
# it isn't set for the Development environment on Vercel -- has to be put back
# by hand afterwards.
BLOB_STORE_ID=
