# Copy to .env.local (gitignored) and fill in from your Supabase project's
# Settings -> API page. See README.md's "Private preview / Google sign-in
# gate" section for the full setup walkthrough.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. NEVER prefix this with NEXT_PUBLIC_, never import it from a
# "use client" file — it bypasses Row Level Security entirely.
SUPABASE_SERVICE_ROLE_KEY=

# Optional — "new sign-in" email notifications. Leave both blank and the
# feature just silently no-ops (sign-in still works, you just won't get
# emailed). Get an API key at resend.com (free tier, no domain needed —
# the "from" address in middleware.ts uses their default onboarding@resend.dev
# sender, which works immediately with zero setup).
RESEND_API_KEY=
NOTIFY_EMAIL=

# Optional — what a brand-new sign-in's `access` starts as. Leave unset (or
# false) so new sign-ups default to limited/preview-only, the normal
# behavior. Set to "true" while testing so you don't have to hand-approve
# every throwaway account — remember to unset it again before sharing the
# real link. Restart the dev server after changing this (env vars only
# load at startup).
DEFAULT_ACCESS=

# Optional — once you've run `node --env-file=.env.local scripts/sync-content-to-supabase.mjs`
# to mirror public/content/ into a public Supabase Storage bucket named
# "content", set this to switch every video/image URL from Vercel's own
# static hosting to Supabase's CDN instead:
# https://<project-ref>.supabase.co/storage/v1/object/public
# Leave blank to keep serving from public/content/ as before (default, and
# what local dev should almost always use).
MEDIA_BASE_URL=
