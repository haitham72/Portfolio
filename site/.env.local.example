# Copy to .env.local (gitignored) and fill in from your Supabase project's
# Settings -> API page. See README.md's "Private preview / Google sign-in
# gate" section for the full setup walkthrough.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. NEVER prefix this with NEXT_PUBLIC_, never import it from a
# "use client" file — it bypasses Row Level Security entirely.
SUPABASE_SERVICE_ROLE_KEY=

# REQUIRED. Videos under public/content/ are gitignored (~186 MB) and live
# in a public Supabase Storage bucket named "content" instead of being
# bundled into every deployment. This is what points every media URL at that
# bucket; without it lib/content.ts emits local /content/... paths for files
# that are not deployed, and every video 404s. Set it here AND on Vercel for
# both Production and Preview -- it's read at build time.
# Format (no trailing slash, bucket name is NOT included):
#   https://<project-ref>.supabase.co/storage/v1/object/public
# Populate the bucket with:
#   node --env-file=.env.local scripts/sync-content-to-supabase.mjs
MEDIA_BASE_URL=
